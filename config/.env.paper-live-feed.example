# Read-only MT5 market data feeding PaperBroker.
FXBOT_PROFILE=paper
FXBOT_LIVE_TRADING_ENABLED=false
FXBOT_DEMO_ORDER_SUBMISSION_ENABLED=false

FXBOT_PAPER_LIVE_SOURCE=mt5
FXBOT_PAPER_LIVE_POLL_INTERVAL_SECONDS=1.0
FXBOT_PAPER_LIVE_RECONNECT_DELAY_SECONDS=5.0
FXBOT_PAPER_LIVE_MAX_CONSECUTIVE_ERRORS=5
FXBOT_PAPER_LIVE_HISTORY_BARS_PER_TIMEFRAME=1000
FXBOT_PAPER_LIVE_EVIDENCE_DIRECTORY=C:\forex-algo-bot\evidence\paper-soak
FXBOT_PAPER_LIVE_REPORT_INTERVAL_SECONDS=60
FXBOT_PAPER_LIVE_STOP_FILENAME=STOP_PAPER_SOAK

# Optional: use credentials below only for read-only market data.
# The runtime still constructs PaperBroker exclusively.
# FXBOT_MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# FXBOT_MT5_LOGIN=
# FXBOT_MT5_PASSWORD=
# FXBOT_MT5_SERVER=
